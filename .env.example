# Copy to .env.local (next to package.json): the Supabase project Cronos uses. It's fixed when
# the app is built (there's no way to change it inside the app); restart `npm run dev` after
# editing. Both values are public: the key only allows what row-level security allows.
# Never put a secret / service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Also accepted: VITE_SUPABASE_ANON_KEY (older projects), and the NEXT_PUBLIC_SUPABASE_URL /
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY names Supabase's "Connect" screen shows.
